<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <a href="/" class="nav-link">BACK TO DASHBOARD</a>
        <h2>REDSTONE SIGNAL CALCULATOR</h2>

        <div class="form-group">
            <label>INITIAL SIGNAL STRENGTH (1-15):</label>
            <input type="number" id="sig" value="15" min="1" max="15" oninput="calc()">
        </div>
        <div class="form-group">
            <label>DUST DISTANCE (BLOCKS):</label>
            <input type="number" id="dist" value="20" min="0" oninput="calc()">
        </div>

        <div class="result-panel">
            <h3>SIGNAL OUTPUT</h3>
            <div>REMAINING POWER: <span id="remPower">0</span></div>
            <div>REPEATERS REQUIRED: <span id="repNeeded">1</span></div>
        </div>
    </div>

    <div class="mob-wrapper">
        <div class="pixel-mob creeper">
            <div class="creeper-head">
                <div class="creeper-face"></div>
            </div>
        </div>
    </div>

    <script>
        function calc() {
            const sig = parseInt(document.getElementById('sig').value) || 15;
            const dist = parseInt(document.getElementById('dist').value) || 0;

            const remaining = Math.max(0, sig - dist);
            const repeaters = Math.floor(dist / 15);

            document.getElementById('remPower').innerText = remaining;
            document.getElementById('repNeeded').innerText = repeaters;
        }
        calc();
    </script>
</body>
</html>