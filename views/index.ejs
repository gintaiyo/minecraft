<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>MINECRAFT UTILITY HUB</h1>
            <p class="subtitle">SELECT A TOOL BELOW TO CALCULATE COORDINATES, MATERIALS, AND MECHANICS.</p>
        </header>

        <div class="tool-grid">
            <% tools.forEach(tool => { %>
                <a href="<%= tool.link %>" class="tool-card">
                    <div class="tool-icon"><%= tool.icon %></div>
                    <h2><%= tool.name %></h2>
                    <p><%= tool.description %></p>
                </a>
            <% }); %>
        </div>
    </div>

    <!-- ACCURATE ANIMATED MOBS WRAPPER -->
    <div class="mob-wrapper">
        <!-- CREEPER -->
        <div class="pixel-mob creeper">
            <div class="c-head">
                <div class="c-face"></div>
            </div>
            <div class="c-body"></div>
            <div class="c-feet">
                <div class="c-foot"></div>
                <div class="c-foot"></div>
            </div>
        </div>

        <!-- WITHER -->
        <div class="pixel-mob wither">
            <div class="w-heads">
                <div class="w-head side">
                    <div class="w-eyes"></div>
                </div>
                <div class="w-head main">
                    <div class="w-eyes"></div>
                </div>
                <div class="w-head side">
                    <div class="w-eyes"></div>
                </div>
            </div>
            <div class="w-bar"></div>
            <div class="w-ribs"></div>
        </div>

        <!-- WOLF -->
        <div class="pixel-mob wolf">
            <div class="w-main">
                <div class="w-body">
                    <div class="w-tail"></div>
                    <div class="w-collar"></div>
                </div>
                <div class="w-head">
                    <div class="w-ears"></div>
                    <div class="w-snout">
                        <div class="w-nose"></div>
                    </div>
                </div>
            </div>
            <div class="w-legs">
                <div class="w-leg"></div>
                <div class="w-leg"></div>
                <div class="w-leg"></div>
                <div class="w-leg"></div>
            </div>
        </div>
    </div>
</body>
</html>